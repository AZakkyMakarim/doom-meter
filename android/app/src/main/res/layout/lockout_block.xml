<?xml version="1.0" encoding="utf-8"?>
<!--
  Block screen (MASTER.md: app background, one primary button, radius 12, 48 high). It scrolls so
  the largest font size never clips. LockoutBlockActivity fills in the texts from the saved Lockout.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockout_root"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lockout_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/lockout_avatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/mood_0_vibing" />

        <TextView
            android:id="@+id/lockout_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/widget_vibing"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockout_until"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/widget_text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/lockout_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/lockout_button_background"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/lockout_on_action"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

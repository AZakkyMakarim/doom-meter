<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!-- The Lockout block screen: dark like the app, no action bar. -->
    <style name="LockoutTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lockout_bg</item>
        <item name="android:statusBarColor">@color/lockout_bg</item>
        <item name="android:navigationBarColor">@color/lockout_bg</item>
    </style>

</resources>
